APP_NAME="Shiftrix Track"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://STAGING_HOSTNAME
SHIFTRIX_EDGE_SECRET=
SHIFTRIX_TUTORIAL_URL=https://shiftrix.io/pages/how-to-configure
IPINFO_LITE_TOKEN=
IPINFO_LITE_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CPANELUSER_shiftrix_stage
DB_USERNAME=CPANELUSER_shiftrix_stage
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_COOKIE=shiftrix_staging_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=support@shiftrix.io
MAIL_FROM_NAME="${APP_NAME} Staging"

VITE_APP_NAME="${APP_NAME}"
